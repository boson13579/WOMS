# =============================================================================
# Secrets & local config — NEVER commit these.
# =============================================================================
.env
.env.*
!.env.example

# =============================================================================
# Python (backend)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage*
coverage.xml
htmlcov/
.tox/
.nox/
dist/
build/

# Celery Beat's local PersistentScheduler cache. Written by
# ``celery -A app.workers.celery_app beat`` next to the launch CWD on
# every run; it stores "when was each scheduled task last fired" so a
# beat restart doesn't refire missed slots. Never source-controlled —
# it's per-deployment runtime state. dbm on different OSes writes
# different file shapes (``.dat`` / ``.dir`` / ``.bak`` on Windows;
# a single file on Unix), hence the glob.
backend/celerybeat-schedule*
.eggs/

# uv (lockfile `uv.lock` IS committed; only ignore caches)
.uv-cache/

# =============================================================================
# Node / pnpm (frontend)
# =============================================================================
node_modules/
pnpm-debug.log*
yarn-error.log
npm-debug.log*
.pnpm-store/
.vite/
.turbo/
*.tsbuildinfo
frontend/dist/
frontend/playwright-report/
frontend/test-results/
coverage/

# =============================================================================
# IDE / editor
# =============================================================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# Merge / patch artifacts
# =============================================================================
*.orig
*.rej

# =============================================================================
# Claude Code project settings (may contain machine-local tokens / paths)
# =============================================================================
.claude/
claude.local.md
backend/CLAUDE.md

# =============================================================================
# Personal scratchpad — never commit. Anything you write under notes/ stays
# on your machine only. To share a note with the team, move it to docs/.
# =============================================================================
notes/
NOTES.md
TODO.local.md
*.local.md

# Stray nested git checkout on a teammate's machine — never re-commit as gitlink
smart-order/

# =============================================================================
# Docker / OS / misc
# =============================================================================
*.log
*.pid
docker-compose.override.yml
AGENTS.md
FRONTEND_SPEC.md

# =============================================================================
# Terraform — never commit local state or *.tfvars (may contain DB passwords,
# JWT secrets, etc.). The `.terraform.lock.hcl` lock file IS committed so
# provider versions stay reproducible across machines.
# =============================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# local SonarQube analysis token
.sonar_token
.scannerwork/
frontend/coverage/
backend/coverage.xml
